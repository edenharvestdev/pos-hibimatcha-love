# ============================================
# Database Configuration
# ============================================
# Hibi Matcha uses one connection, Tamada Clinic uses another
DATABASE_URL=mysql://root:password@localhost:3306/hibimatcha_db

# ============================================
# Application Config
# ============================================
PORT=3000
NODE_ENV=production
SESSION_SECRET=your-secret-key-change-me

# ============================================
# JWT Secrets
# ============================================
MEMBER_JWT_SECRET=hibi-member-secret-change-me
JWT_SECRET=super-secret-backend-key

# ============================================
# Frontend Branding (Vite)
# ============================================
# Set this to "Hibi Matcha" or "Tamada Clinic" depending on deployment
VITE_BRAND_NAME="Hibi Matcha"
VITE_PRIMARY_COLOR="#16a34a" # green for Hibi, maybe blue for Tamada

# ============================================
# Integrations
# ============================================
# AWS S3 (For uploads)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=hibimatcha-uploads

# LINE OA
LINE_CHANNEL_ACCESS_TOKEN=your-line-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Pusher (real-time kitchen/orders — optional in dev)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# Twilio SMS (member OTP — optional in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
